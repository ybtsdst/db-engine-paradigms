{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "configure",
            "command": "cmake",
            "args": [
                "-S",
                ".",
                "-B",
                "build",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
                // other options from .gitlab-ci.yml
                "-DCMAKE_BUILD_TYPE=Debug",
                "-Wno-dev"
            ],
            "problemMatcher": [],
            "detail": "configure task"
        },
        {
            "type": "shell",
            "label": "compile",
            "command": "cmake",
            "args": [
                "--build",
                "build",
                "-j",
                "4"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "detail": "compile task"
        },
    ]
}